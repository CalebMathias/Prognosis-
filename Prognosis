    def quantum_predict(self, track, t, num_scenarios=3):
        state = track.mean[:7]
        scenarios = []
        stability = self.pnn_stability.get(int(track.track_id), 0.5)
        noise_scale = 5 * (1 - stability) * self.pnn_plasticity * self.current_parameter_set['noise_multiplier']
        track_id = int(track.track_id)
        for _ in range(num_scenarios):
            hyper_noise = np.random.normal(0, noise_scale / np.sqrt(self.hyper_dims), 7)
            u, v, s, r, u_dot, v_dot, s_dot = state + hyper_noise
            u_future = u + t * u_dot
            v_future = v + t * v_dot
            s_future = max(s + t * s_dot, 1)
            w_future = np.sqrt(s_future * r) if r > 0 else 1
            h_future = s_future / w_future if w_future > 0 else 1
            box_future = [u_future - w_future / 2, v_future - h_future / 2,
                          u_future + w_future / 2, v_future + h_future / 2]
            field_u = int(u_future // self.field_scale)
            field_v = int(v_future // self.field_scale)
            hyper_coord = np.array([field_u / self.hyper_field.shape[2],
                                   field_v / self.hyper_field.shape[1],
                                   (track_id % 10) / 10.0,
                                   (self.frame_counter % 100) / 100.0])
            hyper_indices = [int(c * self.hyper_field.shape[i]) for i, c in enumerate(hyper_coord)]
            hyper_indices = [max(0, min(idx, self.hyper_field.shape[i] - 1)) for i, idx in enumerate(hyper_indices)]
            consciousness_value = self.hyper_field[tuple(hyper_indices)]
            original_prob = random.uniform(0.5, 1.0 - (1 - stability))
            adjusted_prob = original_prob * (1 + consciousness_value)
            scenarios.append((box_future, (u_future, v_future), adjusted_prob))
        return sorted(scenarios, key=lambda x: x[2], reverse=True)

    def compute_prediction_with_state(self, state, t, param_set):
        scenarios = []
        noise_scale = 5 * (1 - 0.5) * self.pnn_plasticity * param_set['noise_multiplie']
        for _ in range(3):
            hyper_noise = np.random.normal(0, noise_scale / np.sqrt(self.hyper_dims), 7)
            u, v, s, r, u_dot, v_dot, s_dot = state + hyper_noise
            u_future = u + t * u_dot
            v_future = v + t * v_dot
            s_future = max(s + t * s_dot, 1)
            w_future = np.sqrt(s_future * r) if r > 0 else 1
            h_future = s_future / w_future if w_future > 0 else 1
            box_future = [u_future - w_future / 2, v_future - h_future / 2,
                          u_future + w_future / 2, v_future + h_future / 2]
            scenarios.append((box_future, (u_future, v_future), 1.0))
        return sorted(scenarios, key=lambda x: x[2], reverse=True)[0]

    def boxes_overlap(self, box1, box2):
        x1a, y1a, x2a, y2a = box1
        x1b, y1b, x2b, y2b = box2
        return x1a < x2b and x2a > x1b and y1a < y2b and y2a > y1b

    def calculate_ttc(self, track1, track2):
        """Calculate time-to-collision between two tracks."""
        state1 = track1.mean[:7]
        state2 = track2.mean[:7]
        pos1 = np.array([state1[0], state1[1]])  # u, v (center coordinates)
        pos2 = np.array([state2[0], state2[1]])
        vel1 = np.array([state1[4], state1[5]])  # u_dot, v_dot (velocities)
        vel2 = np.array([state2[4], state2[5]])
        V_rel = vel1 - vel2
        P_rel = pos1 - pos2
        if np.all(V_rel == 0):
            return None  # No relative motion
        dot_product = np.dot(P_rel, V_rel)
        if dot_product >= 0:
            return None  # Moving apart or parallel
        V_rel_mag2 = np.dot(V_rel, V_rel)
        if V_rel_mag2 < 1e-6:
            return None  # Relative velocity too small
        ttc = -dot_product / V_rel_mag2
        if ttc < 0:
            return None  # Collision in the past
        # Calculate future positions
        future_pos1 = pos1 + ttc * vel1
        future_pos2 = pos2 + ttc * vel2
        distance = np.linalg.norm(future_pos1 - future_pos2)
        # Calculate radii based on box dimensions
        s1, r1 = state1[2], state1[3]  # s: area, r: aspect ratio
        w1 = np.sqrt(s1 * r1) if s1 > 0 and r1 > 0 else 0
        h1 = s1 / w1 if w1 > 0 else 0
        diag1 = np.sqrt(w1**2 + h1**2)
        radius1 = diag1 / 2
        s2, r2 = state2[2], state2[3]
        w2 = np.sqrt(s2 * r2) if s2 > 0 and r2 > 0 else 0
        h2 = s2 / w2 if w2 > 0 else 0
        diag2 = np.sqrt(w2**2 + h2**2)
        radius2 = diag2 / 2
        if distance < (radius1 + radius2):
            return ttc  # TTC in frames
        return None

