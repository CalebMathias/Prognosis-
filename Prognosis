        confidence = float(confidence) if confidence is not None else 0.5
        self.pnn_stability[track_id] = self.pnn_stability.get(track_id, 0) + (confidence * 0.1)
        self.pnn_stability[track_id] = min(self.pnn_stability[track_id], 1.0)
        self.pnn_protection[track_id] = self.pnn_stability[track_id] * 0.8

    def modulate_plasticity(self, context_complexity):
