    def boxes_overlap(self, box1, box2):
        """Check if two bounding boxes overlap."""
        try:
            x1a, y1a, x2a, y2a = box1
            x1b, y1b, x2b, y2b = box2
            overlap = x1a < x2b and x2a > x1b and y1a < y2b and y2a > y1b
            logging.debug(f"Overlap check between boxes {box1} and {box2}: {overlap}")
            return overlap
        except Exception as e:
            logging.error(f"Error in boxes_overlap: {e}", exc_info=True)
            return False

    def calculate_ttc(self, track1, track2):
        """Calculate time-to-collision with size consideration."""
        try:
            state1 = track1.mean[:7]
            state2 = track2.mean[:7]
            pos1 = np.array([state1[0], state1[1]])
            pos2 = np.array([state2[0], state2[1]])
            vel1 = np.array([state1[4], state1[5]])
            vel2 = np.array([state2[4], state2[5]])
            V_rel = vel1 - vel2
            P_rel = pos1 - pos2
            if np.all(V_rel == 0):
                return None
            dot_product = np.dot(P_rel, V_rel)
            if dot_product >= 0:
                return None
            V_rel_mag2 = np.dot(V_rel, V_rel)
            if V_rel_mag2 < 1e-6:
                return None
            ttc = -dot_product / V_rel_mag2
            if ttc < 0:
                return None
            future_pos1 = pos1 + ttc * vel1
            future_pos2 = pos2 + ttc * vel2
            distance = np.linalg.norm(future_pos1 - future_pos2)
            s1_future = max(state1[2] + ttc * state1[6], 1)
            r1 = state1[3]
            w1_future = np.sqrt(s1_future * r1) if s1_future > 0 and r1 > 0 else 0
            h1_future = s1_future / w1_future if w1_future > 0 else 0
            diag1_future = np.sqrt(w1_future**2 + h1_future**2)
            radius1_future = diag1_future / 2
            s2_future = max(state2[2] + ttc * state2[6], 1)
            r2 = state2[3]
            w2_future = np.sqrt(s2_future * r2) if s2_future > 0 and r2 > 0 else 0
            h2_future = s2_future / w2_future if w2_future > 0 else 0
            diag2_future = np.sqrt(w2_future**2 + h2_future**2)
            radius2_future = diag2_future / 2
            if distance < (radius1_future + radius2_future):
                logging.debug(f"TTC calculated between tracks {track1.track_id} and {track2.track_id}: {ttc}")
                return ttc
            return None
        except Exception as e:
            logging.error(f"Error in calculate_ttc: {e}", exc_info=True)
            return None

    def object_detector(self):
        """Main loop for advanced object detection and analysis."""
        logging.info("Prognosis AI Vision system started.")
        fps = self.cap.get(cv2.CAP_PROP_FPS) or 30
        max_future_t = int(2 * fps)  # Maximum 2 seconds

        while self.cap.isOpened():
            start_time = time.time()
            logging.info(f"Processing frame {self.frame_counter}")
            try:
                ret, frame = self.cap.read()
                if not ret:
                    logging.warning("Failed to capture frame.")
                    continue

                frame_height, frame_width = frame.shape[:2]
                field_height = frame_height // self.field_scale
                field_width = frame_width // self.field_scale
                hyper_size = 10

                # Initialize hyperdimensional field
                if self.hyper_field is None or self.hyper_field.shape[:2] != (field_height, field_width):
                    self.hyper_field = np.zeros((field_height, field_width, hyper_size, hyper_size))
                    self.hyper_field_avg = np.zeros_like(self.hyper_field)
                    logging.info(f"Initialized hyperdimensional field with shape {self.hyper_field.shape}")
                else:
                    self.hyper_field *= self.current_parameter_set['hyper_decay']
                    logging.debug(f"Applied hyper_decay {self.current_parameter_set['hyper_decay']} to hyper_field")

                # Object Detection
                results = self.model(frame, conf=0.4)
                detections = []
                for result in results:
                    for box in result.boxes:
                        x1, y1, x2, y2 = map(int, box.xyxy[0])
                        confidence = box.conf[0]
                        class_id = int(box.cls[0].item()) if box.cls is not None else -1
                        obj_type = self.class_labels.get(class_id, "unknown")
                        detections.append([[x1, y1, x2, y2], confidence, obj_type])
                logging.info(f"Detected {len(detections)} objects: {', '.join([det[2] for det in detections])}")

                # Tracking
                tracks = self.tracker.update_tracks(detections, frame=frame)
                confirmed_tracks = [t for t in tracks if t.is_confirmed()]
                logging.info(f"Tracking {len(confirmed_tracks)} confirmed tracks")

                current_track_ids = set()
                track_data = []
                scene_vector = np.zeros(self.hyper_vector_size)

                for track in tracks:
                    if not track.is_confirmed():
                        continue
                    box = track.to_tlbr()
                    track_id = int(track.track_id)
                    obj_type = str(getattr(track, 'det_class', "unknown"))
                    if obj_type not in self.class_labels.values():
                        for det in detections:
                            det_box = det[0]
                            if abs(det_box[0] - box[0]) < 5 and abs(det_box[1] - box[1]) < 5:
                                obj_type = det[2]
                                break
                        else:
                            obj_type = "unknown"
                    confidence = getattr(track, 'det_conf', 0.5) if hasattr(track, 'det_conf') else 0.5
                    current_track_ids.add(track_id)
                    location = self.get_location(box, frame_width)
                    distance = self.get_distance(box, frame_height)
                    movement, speed = self.get_movement(track, fps)
                    action = self.get_action(obj_type, movement)

                    # Update velocity histories
                    state = track.mean if hasattr(track, 'mean') else [0] * 7
                    u_dot, v_dot = state[4], state[5]
                    if track_id not in self.velocity_histories:
                        self.velocity_histories[track_id] = [(u_dot, v_dot)]
                    else:
                        self.velocity_histories[track_id].append((u_dot, v_dot))
                        if len(self.velocity_histories[track_id]) > 10:
                            self.velocity_histories[track_id].pop(0)

                    # PNN Properties with Age
                    age = self.frame_counter - self.track_histories.get(track_id, (self.frame_counter, None))[0]
                    self.update_pnn_properties(track, confidence, age)

                    # Emotional Weight with Evolutionary Scalers and Interaction Boost
                    emo_weight = self.emotion_weights.get(obj_type, {}).get(distance, 0.5) * self.current_parameter_set['emo_scalers'].get(obj_type, 1.0)
                    if "fast" in movement:
                        emo_weight += self.emotion_weights.get(obj_type, {}).get("fast", 0.0) * self.current_parameter_set['emo_scalers'].get(obj_type, 1.0)
                    s_dot = state[6]
                    if s_dot > 0:
                        emo_weight += 0.1 * (s_dot / 100)
                    emo_weight *= self.pnn_stability.get(track_id, 0.5)

                    # Interaction Boost
                    interaction_boost = 0
                    for other_track in track_data:
                        if other_track['track_id'] != track_id:
                            pair = frozenset([track_id, other_track['track_id']])
                            interaction_count = self.interaction_history.get(pair, 0)
                            if interaction_count > interaction_boost:
                                interaction_boost = interaction_count
                    emo_weight += 0.1 * interaction_boost

                    # Hyperdimensional Processing
                    hyper_pattern = self.hyperdimensional_encode(track)
                    scene_vector += hyper_pattern * emo_weight
                    recalled_state = self.hyperdimensional_recall(hyper_pattern, track_id)
                    if np.any(recalled_state):
                        alpha = 0.2
                        track.mean[:7] = (1 - alpha) * track.mean[:7] + alpha * recalled_state

                    # Update Consciousness Field
                    x_center = (box[0] + box[2]) / 2
                    y_center = (box[1] + box[3]) / 2
                    field_x = int(x_center // self.field_scale)
                    field_y = int(y_center // self.field_scale)
                    if obj_type == "person":
                        increment = self.current_parameter_set['hyper_amplitude'] * (1 + speed / 100)
                        hyper_x = (track_id % 10) % hyper_size
                        hyper_y = (self.frame_counter % 100) % hyper_size
                        for dy in range(-1, 2):
                            for fx in range(-1, 2):
                                fy, fx = field_y + dy, field_x + fx
                                if 0 <= fy < field_height and 0 <= fx < field_width:
                                    self.hyper_field[fy, fx, hyper_x, hyper_y] += increment

                    consciousness_value = np.mean(self.hyper_field[field_y, field_x]) if (0 <= field_y < field_height and 0 <= field_x < field_width) else 0.0

                    # Store Track Information
                    track_info = {
                        "track_id": track_id,
                        "type": obj_type,
                        "location": location,
                        "distance": distance,
                        "movement": movement,
                        "speed": speed,
                        "action": action,
                        "emo_weight": emo_weight,
                        "pnn_stability": self.pnn_stability.get(track_id, 0.5),
                        "consciousness_value": consciousness_value,
                        "box": box,
                        "track_ref": track
                    }
                    track_data.append(track_info)
                    logging.debug(f"Track {track_id} info: type={obj_type}, location={location}, distance={distance}, movement={movement}, speed={speed}")

                    # Movement State Changes
                    if track_id in self.previous_movement and self.previous_movement[track_id] != movement:
                        if movement == "stationary":
                            self.speak(f"{obj_type} has stopped.", emo_weight)
                        elif self.previous_movement[track_id] == "stationary":
                            self.speak(f"{obj_type} is now moving {movement}.", emo_weight)
                    self.previous_movement[track_id] = movement
                    self.track_types[track_id] = obj_type

                    # Visualization
                    x1, y1, x2, y2 = map(int, box)
                    label = f"ID: {track_id} - {obj_type} ({action}) S:{track_info['pnn_stability']:.2f} C:{consciousness_value:.2f}"
                    cv2.rectangle(frame, (x1, y1), (x2, y2), (0, 255, 0), 2)
                    cv2.putText(frame, label, (x1, y1 - 10), cv2.FONT_HERSHEY_SIMPLEX, 0.5, (0, 255, 0), 2)
                    if speed > 200:
                        priority = emo_weight * (1 + consciousness_value)
                        self.speak(f"Alert: Fast-moving {obj_type} {movement} on the {location}.", priority)

                # Scene Vector Normalization and Memory Check
                if np.linalg.norm(scene_vector) > 0:
                    scene_vector /= np.linalg.norm(scene_vector)
                    logging.info(f"Scene vector norm: {np.linalg.norm(scene_vector)}")
                    if self.previous_scene_vector is not None:
                        similarity = np.dot(scene_vector, self.previous_scene_vector)
                        logging.info(f"Scene similarity to previous: {similarity:.2f}")
                        if similarity < 0.8:
                            self.speak("Significant scene change detected.", 1.5)
                    self.previous_scene_vector = scene_vector.copy()
                    for mem_vector, event_type, mem_frame in self.scene_memory:
                        if self.frame_counter - mem_frame > 100:
                            similarity = np.dot(scene_vector, mem_vector) / (np.linalg.norm(scene_vector) * np.linalg.norm(mem_vector) + 1e-10)
                            if similarity > 0.9:
                                self.speak(f"Current scene is similar to a past {event_type} scene.", 2.0)
                                logging.info(f"Similar scene detected: similarity {similarity:.2f} to frame {mem_frame} with event {event_type}")

                # Interaction History Update
                for i in range(len(track_data)):
                    for j in range(i + 1, len(track_data)):
                        center1 = [(track_data[i]['box'][0] + track_data[i]['box'][2])/2, (track_data[i]['box'][1] + track_data[i]['box'][3])/2]
                        center2 = [(track_data[j]['box'][0] + track_data[j]['box'][2])/2, (track_data[j]['box'][1] + track_data[j]['box'][3])/2]
                        distance = np.linalg.norm(np.array(center1) - np.array(center2))
                        if distance < 100 or self.boxes_overlap(track_data[i]['box'], track_data[j]['box']):
                            pair = frozenset([track_data[i]['track_id'], track_data[j]['track_id']])
                            self.interaction_history[pair] = self.interaction_history.get(pair, 0) + 1
                            logging.debug(f"Interaction detected between tracks {track_data[i]['track_id']} and {track_data[j]['track_id']}")

                # Decay Interaction History
                if self.frame_counter % 100 == 0:
                    for pair in list(self.interaction_history.keys()):
                        self.interaction_history[pair] //= 2
                        if self.interaction_history[pair] == 0:
                            del self.interaction_history[pair]
                    logging.debug("Decayed interaction history")

                # Overlap Detection
                overlapping_tracks = set()
                for i in range(len(track_data)):
                    for j in range(i + 1, len(track_data)):
                        if self.boxes_overlap(track_data[i]['box'], track_data[j]['box']):
                            overlapping_tracks.add(track_data[i]['track_id'])
                            overlapping_tracks.add(track_data[j]['track_id'])
                for track in track_data:
                    if track['track_id'] in overlapping_tracks:
                        track['emo_weight'] = min(track['emo_weight'] + 0.2, 1.5)

                # Field Variance Tracking
                field_variance = np.var(self.hyper_field) if self.hyper_field.size > 0 else 0.0
                self.field_variance_history.append(field_variance)
                if len(self.field_variance_history) > 30:
                    self.field_variance_history.pop(0)
                logging.debug(f"Field variance: {field_variance}")

                # Evolutionary Evaluation
                if self.frame_counter % 30 == 0:
                    for track in tracks:
                        if not track.is_confirmed():
                            continue
                        track_id = track.track_id
                        current_state = track.mean[:7]
                        if track_id in self.track_histories:
                            frame_ago, state_ago = self.track_histories[track_id]
                            if self.frame_counter - frame_ago == 30:
                                actual_position = [current_state[0], current_state[1]]
                                for i, param_set in enumerate(self.population):
                                    future_t_eval = param_set['future_t']
                                    top_box, _, _ = self.compute_prediction_with_state(state_ago, future_t_eval, param_set)
                                    predicted_position = [(top_box[0] + top_box[2]) / 2, (top_box[1] + top_box[3]) / 2]
                                    error = np.linalg.norm(np.array(predicted_position) - np.array(actual_position))
                                    field_u = int(actual_position[0] // self.field_scale)
                                    field_v = int(actual_position[1] // self.field_scale)
                                    consciousness_value = np.mean(self.hyper_field[field_v, field_u]) if (0 <= field_v < field_height and 0 <= field_u < field_width) else 0.0
                                    weighted_error = error * (1 + consciousness_value)
                                    self.errors[i]['prediction'].append(weighted_error)
                                    avg_variance = np.mean(self.field_variance_history) if self.field_variance_history else 0.0
                                    self.errors[i]['field_variance'].append(avg_variance)
                        self.track_histories[track_id] = (self.frame_counter, current_state)

                # Evolutionary Update with Enhanced Accuracy Focus
                if self.frame_counter % self.evolution_interval == 0 and self.frame_counter > 0:
                    fitness_scores = []
                    for i in range(len(self.population)):
                        avg_pred_error = np.mean(self.errors[i]['prediction']) if self.errors[i]['prediction'] else float('inf')
                        avg_field_var = np.mean(self.errors[i]['field_variance']) if self.errors[i]['field_variance'] else 0.0
                        norm_pred_error = avg_pred_error / 1000.0 if avg_pred_error != float('inf') else 1.0
                        norm_field_var = abs(avg_field_var - 5.0) / 5.0 if avg_field_var > 0 else 0.0
                        fitness = 0.9 * norm_pred_error + 0.1 * norm_field_var  # Prioritize prediction accuracy
                        fitness_scores.append(fitness)
                    best_idx = np.argmin(fitness_scores)
                    best_param_set = self.population[best_idx]
                    self.current_parameter_set = best_param_set
                    logging.info(f"Evolutionary update - Fitness scores: {', '.join([f'{score:.4f}' for score in fitness_scores])}, Best index: {best_idx}, Best params: {best_param_set}")
                    new_population = [best_param_set]
                    for _ in range(len(self.population) - 1):
                        new_params = {
                            'noise_multiplier': max(0.1, min(2.0, best_param_set['noise_multiplier'] + np.random.normal(0, 0.05))),
                            'hyper_decay': max(0.5, min(0.99, best_param_set['hyper_decay'] + np.random.normal(0, 0.02))),
                            'hyper_amplitude': max(0.1, min(2.0, best_param_set['hyper_amplitude'] + np.random.normal(0, 0.05))),
                            'emo_scalers': {
                                'person': max(0.1, best_param_set['emo_scalers']['person'] + np.random.normal(0, 0.05)),
                                'car': max(0.1, best_param_set['emo_scalers']['car'] + np.random.normal(0, 0.05)),
                                'bicycle': max(0.1, best_param_set['emo_scalers']['bicycle'] + np.random.normal(0, 0.05)),
                            },
                            'history_length': max(1, min(10, best_param_set['history_length'] + np.random.randint(-1, 2))),
                            'future_t': max(30, min(max_future_t, best_param_set['future_t'] + np.random.randint(-5, 6)))
                        }
                        new_population.append(new_params)
                    self.population = new_population
                    self.errors = {i: {'prediction': [], 'field_variance': []} for i in range(len(self.population))}

                # Detect Lost and New Tracks
                lost_ids = self.previous_track_ids - current_track_ids
                for lost_id in lost_ids:
                    if lost_id in self.track_types:
                        obj_type = self.track_types[lost_id]
                        self.speak(f"A {obj_type} has left the scene.", 0.5)
                        logging.info(f"Track {lost_id} ({obj_type}) lost")
                    if lost_id in self.velocity_histories:
                        del self.velocity_histories[lost_id]

                new_ids = current_track_ids - self.previous_track_ids
                for track_id in new_ids:
                    track = next(t for t in track_data if t["track_id"] == track_id)
                    priority = track["emo_weight"] * (1 + track["consciousness_value"])
                    self.speak(f"A {track['type']} has appeared on the {track['location']}.", priority)
                    logging.info(f"New track {track_id} ({track['type']}) appeared on {track['location']}")

                self.previous_track_ids = current_track_ids
                self.track_histories = {k: v for k, v in self.track_histories.items() if k in current_track_ids}
                self.previous_movement = {k: v for k, v in self.previous_movement.items() if k in current_track_ids}
                self.track_types = {k: v for k, v in self.track_types.items() if k in current_track_ids}

                self.modulate_plasticity(len(tracks) * 10)

                # Future Predictions with Dynamic Horizon
                future_t = self.current_parameter_set['future_t']
                logging.debug(f"Using future_t={future_t} for predictions")
                future_scenarios = {track.track_id: self.quantum_predict(track, future_t) for track in tracks if track.is_confirmed()}
                for track_id, scenarios in future_scenarios.items():
                    top_box, top_pos, top_prob = scenarios[0]
                    logging.debug(f"Predicted future position for track {track_id}: {top_pos} with probability {top_prob}")
                    x1, y1, x2, y2 = map(int, top_box)
                    cv2.rectangle(frame, (x1, y1), (x2, y2), (255, 0, 0), 2)
                    cv2.putText(frame, f"Pred {future_t/fps:.1f}s", (x1, y1 - 25), cv2.FONT_HERSHEY_SIMPLEX, 0.5, (255, 0, 0), 2)

                # Collision Detection with TTC
                for i in range(len(track_data)):
                    for j in range(i + 1, len(track_data)):
                        track1_info = track_data[i]
                        track2_info = track_data[j]
                        track1 = track1_info['track_ref']
                        track2 = track2_info['track_ref']
                        ttc = self.calculate_ttc(track1, track2)
                        if ttc is not None and ttc < 2.0 * fps:
                            ttc_seconds = ttc / fps
                            priority = max(track1_info["emo_weight"], track2_info["emo_weight"]) * 1.5
                            self.speak(f"Potential collision between {track1_info['type']} and {track2_info['type']} in {ttc_seconds:.1f} seconds.", priority)
                            logging.info(f"Potential collision detected: {track1_info['type']} (ID: {track1_info['track_id']}) and {track2_info['type']} (ID: {track2_info['track_id']}) in {ttc_seconds:.1f}s")
                            if len(self.scene_memory) < 100:
                                self.scene_memory.append((scene_vector.copy(), "collision", self.frame_counter))
                            else:
                                self.scene_memory.pop(0)
                                self.scene_memory.append((scene_vector.copy(), "collision", self.frame_counter))

                # Probabilistic Future Overlaps
                track_ids = list(future_scenarios.keys())
                for i in range(len(track_ids)):
                    for j in range(i + 1, len(track_ids)):
                        id1, id2 = track_ids[i], track_ids[j]
                        scenarios1 = future_scenarios[id1]
                        scenarios2 = future_scenarios[id2]
                        collision_prob = 0.0
                        for box1, _, prob1 in scenarios1:
                            for box2, _, prob2 in scenarios2:
                                if self.boxes_overlap(box1, box2):
                                    collision_prob += prob1 * prob2
                        if collision_prob > 0.5:
                            track1 = next(t for t in track_data if t["track_id"] == id1)
                            track2 = next(t for t in track_data if t["track_id"] == id2)
                            priority = max(track1["emo_weight"], track2["emo_weight"]) * collision_prob
                            self.speak(f"Predicted collision between {track1['type']} and {track2['type']} with probability {collision_prob:.2f}.", priority)
                            logging.info(f"Predicted collision probability: {collision_prob:.2f} between {track1['type']} (ID: {id1}) and {track2['type']} (ID: {id2})")

                # Anomaly Detection
                alpha = 0.01
                self.hyper_field_avg = alpha * self.hyper_field + (1 - alpha) * self.hyper_field_avg
                diff = np.abs(self.hyper_field - self.hyper_field_avg)
                diff_sum = np.sum(diff, axis=(2, 3))
                anomaly_threshold = 5.0
                if np.max(diff_sum) > anomaly_threshold:
                    anomaly_y, anomaly_x = np.unravel_index(np.argmax(diff_sum), diff_sum.shape)
                    anomaly_location = (anomaly_x * self.field_scale, anomaly_y * self.field_scale)
                    self.speak(f"Anomaly detected at {anomaly_location}.", 2.0)
                    logging.info(f"Anomaly detected at {anomaly_location}")
                    if len(self.scene_memory) < 100:
                        self.scene_memory.append((scene_vector.copy(), "anomaly", self.frame_counter))
                    else:
                        self.scene_memory.pop(0)
                        self.scene_memory.append((scene_vector.copy(), "anomaly", self.frame_counter))

                # Hotspot Detection
                hyper_sum = np.sum(self.hyper_field, axis=(2, 3))
                if np.any(hyper_sum > 10):
                    max_y, max_x = np.unravel_index(np.argmax(hyper_sum), hyper_sum.shape)
                    hotspot_location = (max_x * self.field_scale, max_y * self.field_scale)
                    self.speak(f"Consciousness hotspot at {hotspot_location}.", 2.0)
                    logging.info(f"Hotspot detected at {hotspot_location}")

                self.frame_counter += 1

                # Periodic Summary
                if self.frame_counter >= 150:
                    type_counts = Counter([t['type'] for t in track_data])
                    summary = "Scene summary: " + ", ".join(f"{count} {t}{'s' if count > 1 else ''}" for t, count in type_counts.items())
                    self.speak(summary, 0.5)
                    logging.info(f"Scene summary: {summary}")
                    self.frame_counter = 0

                cv2.imshow("Prognosis AI Vision with Hyperdimensional Consciousness", frame)
                if cv2.waitKey(1) & 0xFF == ord('q'):
                    break

            except Exception as e:
                logging.error(f"Error processing frame {self.frame_counter}: {e}", exc_info=True)
            finally:
                processing_time = time.time() - start_time
                logging.debug(f"Frame {self.frame_counter} processed in {processing_time:.3f} seconds")

        self.cap.release()
        cv2.destroyAllWindows()
        self.speech_queue.put((0, None))
        self.speech_thread.join()
        logging.info("Prognosis system terminated.")

