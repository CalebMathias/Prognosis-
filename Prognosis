    def _speech_loop(self):
        """Run a continuous loop to process speech queue items with priority."""
        while True:
            priority, message = self.speech_queue.get()  # Get highest priority (lowest -priority value)
            if message is None:
                break  # Exit signal
            self.tts.say(message)
            self.tts.runAndWait()
            self.speech_queue.task_done()

    def speak(self, message, priority=1.0):
        """Queue a message to be spoken with priority handling."""
        if priority is None or priority <= 0:
            priority = 1.0  # Default priority
        if message not in self.last_spoken or self.last_spoken[message] > 30 * (1 / priority):
            self.speech_queue.put((-priority, message))  # Negative priority for max-heap behavior
            self.last_spoken[message] = 0
        for key in list(self.last_spoken.keys()):
            self.last_spoken[key] += 1
            if self.last_spoken[key] > 60:
                del self.last_spoken[key]  # Clean up old entries

    def get_location(self, box, frame_width):
        """Determine the horizontal location of an object in the frame."""
        x_center = (box[0] + box[2]) / 2
        if x_center < frame_width / 3:
            return "left"
        elif x_center < 2 * frame_width / 3:
            return "center"
        else:
            return "right"

    def get_distance(self, box, frame_height):
        """Estimate the distance of an object based on its height in the frame."""
        height = box[3] - box[1]
        if height > 0.5 * frame_height:
            return "close"
        elif height > 0.2 * frame_height:
            return "medium"
        else:
            return "far"

    def get_movement(self, track, fps):
        """Calculate the movement and speed of a track."""
        state = track.mean if hasattr(track, 'mean') else [0] * 7
        vx, vy = state[4], state[5]  # Velocity components
        speed = (vx**2 + vy**2)**0.5 * fps
        if speed < 10:
            return "stationary", speed
        direction = "right" if vx > 0 else "left"
        speed_label = "fast" if speed > 200 else "slow"
        return f"{speed_label} {direction}", speed

    def get_action(self, obj_type, movement):
        """Map object type and movement to an action description."""
        state = "moving" if movement != "stationary" else "stationary"
        return self.action_map.get(obj_type, {}).get(state, "")

    def hyperdimensional_encode(self, track):
        """Encode a track's state into a hyperdimensional vector."""
        state = track.mean[:7]  # Full 7D state: [u, v, s, r, u_dot, v_dot, s_dot]
        np.random.seed(int(track.track_id))  # Seed for consistency per track
        projection_matrix = np.random.normal(0, 1, (7, self.hyper_vector_size))
        hyper_vector = np.tanh(np.dot(state, projection_matrix))
        norm = np.linalg.norm(hyper_vector)
        hyper_vector = hyper_vector / (norm if norm > 0 else 1.0)
        if len(self.holo_memory) >= self.max_memory:
            self.holo_memory.pop(0)  # Remove oldest entry if at capacity
        self.holo_memory.append((hyper_vector, state))  # Store vector and state
        return hyper_vector

    def hyperdimensional_recall(self, current_vector, track_id):
        """Recall the most similar past state from holographic memory."""
        if not self.holo_memory:
            return np.zeros(7)
        similarities = [np.dot(current_vector, mem[0]) / (np.linalg.norm(current_vector) * np.linalg.norm(mem[0]) + 1e-10)
                        for mem in self.holo_memory]
        best_match_idx = np.argmax(similarities)
        stability_boost = self.pnn_stability.get(int(track_id), 0.5)
        if similarities[best_match_idx] > (0.5 * stability_boost):
            return self.holo_memory[best_match_idx][1]  # Return associated state
        return np.zeros(7)

    def update_pnn_properties(self, track, confidence):
        """Update PNN-inspired stability and protection properties."""
        track_id = int(track.track_id)
        confidence = float(confidence) if confidence is not None else 0.5
        self.pnn_stability[track_id] = min(self.pnn_stability.get(track_id, 0) + (confidence * 0.1), 1.0)
        self.pnn_protection[track_id] = self.pnn_stability[track_id] * 0.8

    def modulate_plasticity(self, context_complexity):
        """Adjust plasticity based on scene complexity."""
        self.pnn_plasticity = max(0.1, 1.0 - (context_complexity / 100))

    def quantum_predict(self, track, t, num_scenarios=3):
        """Predict future positions with quantum-inspired noise."""
        state = track.mean[:7]
        scenarios = []
        stability = self.pnn_stability.get(int(track.track_id), 0.5)
        noise_scale = 5 * (1 - stability) * self.pnn_plasticity * self.current_parameter_set['noise_multiplier']
        track_id = int(track.track_id)
        for _ in range(num_scenarios):
            hyper_noise = np.random.normal(0, noise_scale / np.sqrt(self.hyper_dims), 7)
            u, v, s, r, u_dot, v_dot, s_dot = state + hyper_noise
            u_future = u + t * u_dot
            v_future = v + t * v_dot
            s_future = max(s + t * s_dot, 1)
            w_future = np.sqrt(s_future * r) if r > 0 else 1
            h_future = s_future / w_future if w_future > 0 else 1
            box_future = [u_future - w_future / 2, v_future - h_future / 2,
                          u_future + w_future / 2, v_future + h_future / 2]
            field_u = int(u_future // self.field_scale)
            field_v = int(v_future // self.field_scale)
            hyper_coord = np.array([field_u / self.hyper_field.shape[2],
                                   field_v / self.hyper_field.shape[1],
                                   (track_id % 10) / 10.0,
                                   (self.frame_counter % 100) / 100.0])
            hyper_indices = [int(c * self.hyper_field.shape[i]) for i, c in enumerate(hyper_coord)]
            hyper_indices = [max(0, min(idx, self.hyper_field.shape[i] - 1)) for i, idx in enumerate(hyper_indices)]
            consciousness_value = self.hyper_field[tuple(hyper_indices)]
            original_prob = random.uniform(0.5, 1.0 - (1 - stability))
            adjusted_prob = original_prob * (1 + consciousness_value)
            scenarios.append((box_future, (u_future, v_future), adjusted_prob))
        return sorted(scenarios, key=lambda x: x[2], reverse=True)

    def compute_prediction_with_state(self, state, t, param_set):
        """Compute a future prediction for a given state and parameter set."""
        scenarios = []
        noise_scale = 5 * (1 - 0.5) * self.pnn_plasticity * param_set['noise_multiplier']  # Fixed typo
        for _ in range(3):
            hyper_noise = np.random.normal(0, noise_scale / np.sqrt(self.hyper_dims), 7)
            u, v, s, r, u_dot, v_dot, s_dot = state + hyper_noise
            u_future = u + t * u_dot
            v_future = v + t * v_dot
            s_future = max(s + t * s_dot, 1)
            w_future = np.sqrt(s_future * r) if r > 0 else 1
            h_future = s_future / w_future if w_future > 0 else 1
            box_future = [u_future - w_future / 2, v_future - h_future / 2,
                          u_future + w_future / 2, v_future + h_future / 2]
            scenarios.append((box_future, (u_future, v_future), 1.0))
        return sorted(scenarios, key=lambda x: x[2], reverse=True)[0]

    def boxes_overlap(self, box1, box2):
        """Check if two bounding boxes overlap."""
        x1a, y1a, x2a, y2a = box1
        x1b, y1b, x2b, y2b = box2
        return x1a < x2b and x2a > x1b and y1a < y2b and y2a > y1b

    def calculate_ttc(self, track1, track2):
        """Calculate time-to-collision with future size consideration."""
        state1 = track1.mean[:7]
        state2 = track2.mean[:7]
        pos1 = np.array([state1[0], state1[1]])
        pos2 = np.array([state2[0], state2[1]])
        vel1 = np.array([state1[4], state1[5]])
        vel2 = np.array([state2[4], state2[5]])
        V_rel = vel1 - vel2
        P_rel = pos1 - pos2
        if np.all(V_rel == 0):
            return None
        dot_product = np.dot(P_rel, V_rel)
        if dot_product >= 0:
            return None
        V_rel_mag2 = np.dot(V_rel, V_rel)
        if V_rel_mag2 < 1e-6:
            return None
        ttc = -dot_product / V_rel_mag2
        if ttc < 0:
            return None
        future_pos1 = pos1 + ttc * vel1
        future_pos2 = pos2 + ttc * vel2
        distance = np.linalg.norm(future_pos1 - future_pos2)
        # Use future sizes for collision detection
        s1_future = max(state1[2] + ttc * state1[6], 1)
        r1 = state1[3]
        w1_future = np.sqrt(s1_future * r1) if s1_future > 0 and r1 > 0 else 0
        h1_future = s1_future / w1_future if w1_future > 0 else 0
        diag1_future = np.sqrt(w1_future**2 + h1_future**2)
        radius1_future = diag1_future / 2
        s2_future = max(state2[2] + ttc * state2[6], 1)
        r2 = state2[3]
        w2_future = np.sqrt(s2_future * r2) if s2_future > 0 and r2 > 0 else 0
        h2_future = s2_future / w2_future if w2_future > 0 else 0
        diag2_future = np.sqrt(w2_future**2 + h2_future**2)
        radius2_future = diag2_future / 2
        if distance < (radius1_future + radius2_future):
            return ttc
        return None

    def object_detector(self):
        """Main loop for object detection, tracking, and analysis."""
        print("🚀 Prognosis AI Vision with Hyperdimensional Consciousness Field and Multi-Parameter Evolutionary Adaptation Activated...")
        fps = self.cap.get(cv2.CAP_PROP_FPS) or 30
        future_t = 30  # Prediction horizon in frames

        while self.cap.isOpened():
            ret, frame = self.cap.read()
            if not ret:
                print("Failed to capture frame.")
                break

            frame_height, frame_width = frame.shape[:2]
            field_height = frame_height // self.field_scale
            field_width = frame_width // self.field_scale
            hyper_size = 10

            # Initialize or adjust hyperdimensional field
            if self.hyper_field is None or self.hyper_field.shape[:2] != (field_height, field_width):
                self.hyper_field = np.zeros((field_height, field_width, hyper_size, hyper_size))
                self.hyper_field_avg = np.zeros_like(self.hyper_field)
            else:
                self.hyper_field *= self.current_parameter_set['hyper_decay']  # Apply decay

            # Object Detection
            results = self.model(frame, conf=0.4)
            detections = []
            for result in results:
                for box in result.boxes:
                    x1, y1, x2, y2 = map(int, box.xyxy[0])
                    confidence = box.conf[0]
                    try:
                        class_id = int(box.cls[0].item())
                    except (TypeError, ValueError):
                        logging.warning(f"Invalid class_id: {box.cls}")
                        class_id = -1
                    obj_type = self.class_labels.get(class_id, "unknown")
                    detections.append([[x1, y1, x2, y2], confidence, obj_type])

            # Tracking
            tracks = self.tracker.update_tracks(detections, frame=frame)
            current_track_ids = set()
            track_data = []
            scene_vector = np.zeros(self.hyper_vector_size)

            for track in tracks:
                if not track.is_confirmed():
                    continue
                box = track.to_tlbr()
                try:
                    track_id = int(track.track_id)
                except (TypeError, ValueError) as e:
                    logging.error(f"Invalid track_id {track.track_id}: {e}")
                    continue
                obj_type = str(getattr(track, 'det_class', "unknown"))
                if obj_type not in self.class_labels.values():
                    for det in detections:
                        det_box = det[0]
                        if abs(det_box[0] - box[0]) < 5 and abs(det_box[1] - box[1]) < 5:
                            obj_type = det[2]
                            break
                    else:
                        logging.warning(f"Unknown obj_type for track {track_id}. Set to 'unknown'")
                        obj_type = "unknown"
                confidence = getattr(track, 'det_conf', 0.5) if hasattr(track, 'det_conf') else 0.5
                current_track_ids.add(track_id)
                location = self.get_location(box, frame_width)
                distance = self.get_distance(box, frame_height)
                movement, speed = self.get_movement(track, fps)
                action = self.get_action(obj_type, movement)

                self.update_pnn_properties(track, confidence)

                # Emotional Weight Calculation
                emo_weight = self.emotion_weights.get(obj_type, {}).get(distance, 0.5)
                if "fast" in movement:
                    emo_weight += self.emotion_weights.get(obj_type, {}).get("fast", 0.0)
                state = track.mean if hasattr(track, 'mean') else [0] * 7
                s_dot = state[6]  # Rate of change of area
                if s_dot > 0:
                    emo_weight += 0.1 * (s_dot / 100)  # Increase weight for approaching objects
                emo_weight *= self.pnn_stability.get(track_id, 0.5)

                # Hyperdimensional Processing
                hyper_pattern = self.hyperdimensional_encode(track)
                scene_vector += hyper_pattern * emo_weight
                recalled_state = self.hyperdimensional_recall(hyper_pattern, track_id)
                if np.any(recalled_state):
                    alpha = 0.2  # Blending factor
                    track.mean[:7] = (1 - alpha) * track.mean[:7] + alpha * recalled_state

                # Update Consciousness Field
                x_center = (box[0] + box[2]) / 2
                y_center = (box[1] + box[3]) / 2
                field_x = int(x_center // self.field_scale)
                field_y = int(y_center // self.field_scale)
                if obj_type == "person":
                    increment = self.current_parameter_set['hyper_amplitude'] * (1 + speed / 100)
                    try:
                        hyper_x = (track_id % 10) % hyper_size
                        hyper_y = (self.frame_counter % 100) % hyper_size
                        for dy in range(-1, 2):
                            for dx in range(-1, 2):
                                fy, fx = field_y + dy, field_x + dx
                                if 0 <= fy < field_height and 0 <= fx < field_width:
                                    self.hyper_field[fy, fx, hyper_x, hyper_y] += increment
                    except TypeError as e:
                        logging.error(f"Hyperdimensional indexing error for track {track_id}: {e}")
                        continue

                consciousness_value = 0.0
                if 0 <= field_y < field_height and 0 <= field_x < field_width:
                    consciousness_value = np.mean(self.hyper_field[field_y, field_x])

                # Store Track Information
                track_info = {
                    "track_id": track_id,
                    "type": obj_type,
                    "location": location,
                    "distance": distance,
                    "movement": movement,
                    "speed": speed,
                    "action": action,
                    "emo_weight": emo_weight,
                    "pnn_stability": self.pnn_stability.get(track_id, 0.5),
                    "consciousness_value": consciousness_value,
                    "box": box
                }
                track_data.append(track_info)

                # Movement State Change Detection
                if track_id in self.previous_movement:
                    prev_movement = self.previous_movement[track_id]
                    if prev_movement != movement:
                        if movement == "stationary":
                            self.speak(f"{obj_type} has stopped.", emo_weight)
                        elif prev_movement == "stationary":
                            self.speak(f"{obj_type} is now moving {movement}.", emo_weight)
                self.previous_movement[track_id] = movement
                self.track_types[track_id] = obj_type

                # Visualization
                x1, y1, x2, y2 = map(int, box)
                label = f"ID: {track_id} - {obj_type} ({action}) S:{track_info['pnn_stability']:.2f} C:{consciousness_value:.2f}"
                cv2.rectangle(frame, (x1, y1), (x2, y2), (0, 255, 0), 2)
                cv2.putText(frame, label, (x1, y1 - 10), cv2.FONT_HERSHEY_SIMPLEX, 0.5, (0, 255, 0), 2)
                if speed > 200:
                    priority = emo_weight * (1 + consciousness_value)
                    self.speak(f"Alert: Fast-moving {obj_type} {movement} on the {location}.", priority)

            # Scene Change Detection
            if np.linalg.norm(scene_vector) > 0:
                scene_vector /= np.linalg.norm(scene_vector)
                if self.previous_scene_vector is not None:
                    similarity = np.dot(scene_vector, self.previous_scene_vector)
                    if similarity < 0.8:
                        self.speak("Significant scene change detected.", 1.5)
                        logging.info(f"Scene similarity: {similarity}")
                self.previous_scene_vector = scene_vector.copy()

            # Overlap Detection
            overlapping_tracks = set()
            for i in range(len(track_data)):
                for j in range(i + 1, len(track_data)):
                    if self.boxes_overlap(track_data[i]['box'], track_data[j]['box']):
                        overlapping_tracks.add(track_data[i]['track_id'])
                        overlapping_tracks.add(track_data[j]['track_id'])
            for track in track_data:
                if track['track_id'] in overlapping_tracks:
                    track['emo_weight'] = min(track['emo_weight'] + 0.2, 1.5)

            # Field Variance Tracking
            field_variance = np.var(self.hyper_field) if self.hyper_field.size > 0 else 0.0
            self.field_variance_history.append(field_variance)
            if len(self.field_variance_history) > 30:
                self.field_variance_history.pop(0)

            # Evolutionary Evaluation
            if self.frame_counter % 30 == 0:
                for track in tracks:
                    if not track.is_confirmed():
                        continue
                    track_id = track.track_id
                    current_state = track.mean[:7]
                    if track_id in self.track_histories:
                        frame_30_ago, state_30_ago = self.track_histories[track_id]
                        if self.frame_counter - frame_30_ago == 30:
                            actual_position = [current_state[0], current_state[1]]
                            for i, param_set in enumerate(self.population):
                                top_box, _, _ = self.compute_prediction_with_state(state_30_ago, 30, param_set)
                                predicted_position = [(top_box[0] + top_box[2]) / 2, (top_box[1] + top_box[3]) / 2]
                                error = np.linalg.norm(np.array(predicted_position) - np.array(actual_position))
                                field_u = int(actual_position[0] // self.field_scale)
                                field_v = int(actual_position[1] // self.field_scale)
                                consciousness_value = 0.0
                                if 0 <= field_v < field_height and 0 <= field_u < field_width:
                                    consciousness_value = np.mean(self.hyper_field[field_v, field_u])
                                weighted_error = error * (1 + consciousness_value)
                                self.errors[i]['prediction'].append(weighted_error)
                                avg_variance = np.mean(self.field_variance_history) if self.field_variance_history else 0.0
                                self.errors[i]['field_variance'].append(avg_variance)
                    self.track_histories[track_id] = (self.frame_counter, current_state)

            # Evolutionary Update
            if self.frame_counter % self.evolution_interval == 0 and self.frame_counter > 0:
                fitness_scores = []
                for i in range(len(self.population)):
                    avg_pred_error = np.mean(self.errors[i]['prediction']) if self.errors[i]['prediction'] else float('inf')
                    avg_field_var = np.mean(self.errors[i]['field_variance']) if self.errors[i]['field_variance'] else 0.0
                    norm_pred_error = avg_pred_error / 1000.0 if avg_pred_error != float('inf') else 1.0
                    norm_field_var = abs(avg_field_var - 5.0) / 5.0 if avg_field_var > 0 else 0.0
                    fitness = 0.7 * norm_pred_error + 0.3 * norm_field_var
                    fitness_scores.append(fitness)
                best_idx = np.argmin(fitness_scores)
                best_param_set = self.population[best_idx]
                self.current_parameter_set = best_param_set
                new_population = [best_param_set]
                for _ in range(len(self.population) - 1):
                    new_params = {
                        'noise_multiplier': max(0.1, min(2.0, best_param_set['noise_multiplier'] + np.random.normal(0, 0.05))),
                        'hyper_decay': max(0.5, min(0.99, best_param_set['hyper_decay'] + np.random.normal(0, 0.02))),
