    def _speech_loop(self):
        """Process speech queue items with priority."""
        while True:
            try:
                priority, message = self.speech_queue.get()
                if message is None:
                    break
                logging.info(f"Speaking message: '{message}' with priority {priority}")
                self.tts.say(message)
                self.tts.runAndWait()
            except Exception as e:
                logging.error(f"Error in speech synthesis: {e}", exc_info=True)
            finally:
                self.speech_queue.task_done()

    def speak(self, message, priority=1.0):
        """Queue a message to be spoken with priority handling."""
        try:
            if priority is None or priority <= 0:
                priority = 1.0
            if message not in self.last_spoken or self.last_spoken[message] > 30 * (1 / priority):
                self.speech_queue.put((-priority, message))
                self.last_spoken[message] = 0
            for key in list(self.last_spoken.keys()):
                self.last_spoken[key] += 1
                if self.last_spoken[key] > 60:
                    del self.last_spoken[key]
        except Exception as e:
            logging.error(f"Error in speak method: {e}", exc_info=True)

    def get_location(self, box, frame_width):
        """Determine object's horizontal location."""
        try:
            x_center = (box[0] + box[2]) / 2
            location = "left" if x_center < frame_width / 3 else "center" if x_center < 2 * frame_width / 3 else "right"
            logging.debug(f"Calculated location for box {box}: {location}")
            return location
        except Exception as e:
            logging.error(f"Error in get_location: {e}", exc_info=True)
            return "unknown"

    def get_distance(self, box, frame_height):
        """Estimate object distance based on height."""
        try:
            height = box[3] - box[1]
            distance = "close" if height > 0.5 * frame_height else "medium" if height > 0.2 * frame_height else "far"
            logging.debug(f"Estimated distance for box {box}: {distance}")
            return distance
        except Exception as e:
            logging.error(f"Error in get_distance: {e}", exc_info=True)
            return "unknown"

    def get_movement(self, track, fps):
        """Calculate track movement and speed."""
        try:
            state = track.mean if hasattr(track, 'mean') else [0] * 7
            vx, vy = state[4], state[5]
            speed = (vx**2 + vy**2)**0.5 * fps
            if speed < 10:
                movement = "stationary"
            else:
                direction = "right" if vx > 0 else "left"
                speed_label = "fast" if speed > 200 else "slow"
                movement = f"{speed_label} {direction}"
            logging.debug(f"Track {track.track_id} movement: {movement}, speed: {speed}")
            return movement, speed
        except Exception as e:
            logging.error(f"Error in get_movement: {e}", exc_info=True)
            return "unknown", 0

    def get_action(self, obj_type, movement):
        """Map object type and movement to action."""
        try:
            state = "moving" if movement != "stationary" else "stationary"
            action = self.action_map.get(obj_type, {}).get(state, "")
            logging.debug(f"Action for {obj_type} with movement {movement}: {action}")
            return action
        except Exception as e:
            logging.error(f"Error in get_action: {e}", exc_info=True)
            return ""

    def hyperdimensional_encode(self, track):
        """Encode track state into hyperdimensional vector."""
        try:
            state = track.mean[:7]
            np.random.seed(int(track.track_id))
            projection_matrix = np.random.normal(0, 1, (7, self.hyper_vector_size))
            hyper_vector = np.tanh(np.dot(state, projection_matrix))
            norm = np.linalg.norm(hyper_vector)
            hyper_vector = hyper_vector / (norm if norm > 0 else 1.0)
            if len(self.holo_memory) >= self.max_memory:
                self.holo_memory.pop(0)
            self.holo_memory.append((hyper_vector, state))
            logging.debug(f"Encoded track {track.track_id} into hypervector of shape {hyper_vector.shape}")
            return hyper_vector
        except Exception as e:
            logging.error(f"Error in hyperdimensional_encode: {e}", exc_info=True)
            return np.zeros(self.hyper_vector_size)

    def hyperdimensional_recall(self, current_vector, track_id):
        """Recall similar past state from memory."""
        try:
            if not self.holo_memory:
                return np.zeros(7)
            similarities = [np.dot(current_vector, mem[0]) / (np.linalg.norm(current_vector) * np.linalg.norm(mem[0]) + 1e-10)
                           for mem in self.holo_memory]
            best_match_idx = np.argmax(similarities)
            stability_boost = self.pnn_stability.get(int(track_id), 0.5)
            if similarities[best_match_idx] > (0.5 * stability_boost):
                logging.debug(f"Recalled state for track {track_id} with similarity {similarities[best_match_idx]:.2f}")
                return self.holo_memory[best_match_idx][1]
            return np.zeros(7)
        except Exception as e:
            logging.error(f"Error in hyperdimensional_recall: {e}", exc_info=True)
            return np.zeros(7)

